{
	admin off
}

# Railway sets PORT. BACKEND_HOST defaults to the backend service on Railway's private network.
:{$PORT:8080} {
	encode gzip
	handle /api/* {
		reverse_proxy {$BACKEND_HOST:backend.railway.internal:8000}
	}
	handle /ws/* {
		reverse_proxy {$BACKEND_HOST:backend.railway.internal:8000}
	}
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
