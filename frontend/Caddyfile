{
	admin off
}

# Railway sets PORT. BACKEND_HOST is the backend private address, e.g. ${{backend.RAILWAY_PRIVATE_DOMAIN}}:8000.
:{$PORT:8080} {
	encode gzip
	handle /api/* {
		reverse_proxy {$BACKEND_HOST}
	}
	handle /ws/* {
		reverse_proxy {$BACKEND_HOST}
	}
	handle {
		root * /srv
		# index.html is re-checked on every load, so a deploy shows up at once; hashed assets never change.
		@page not path /assets/*
		header @page Cache-Control "no-cache"
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
