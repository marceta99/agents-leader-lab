{
	admin off
}

# Railway sets PORT. BACKEND_HOST is the backend private address, e.g. ${{backend.RAILWAY_PRIVATE_DOMAIN}}:8000.
:{$PORT:8080} {
	encode gzip
	handle /api/* {
		reverse_proxy {$BACKEND_HOST}
	}
	handle /ws/* {
		reverse_proxy {$BACKEND_HOST}
	}
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
